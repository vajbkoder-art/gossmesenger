# Server
PORT=3001
NODE_ENV=development

# Public URL (used for CORS and client config)
PUBLIC_HTTPS_URL=http://localhost:3001

# Admin credentials
ADMIN_LOGIN=admin
ADMIN_PASSWORD=changeme

# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# TURN servers (for WebRTC)
TURN_HOST=
TURN_USER=
TURN_PASS=
TURN2_HOST=
TURN2_USER=
TURN2_PASS=

# Mediasoup
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_ANNOUNCED_IP2=
MEDIASOUP_RTC_MIN_PORT=10000
MEDIASOUP_RTC_MAX_PORT=10100
MEDIASOUP_TCP_ONLY=0
